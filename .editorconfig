# Editor settings that match what CI checks (make text).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,Makefile}]
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break; we don't use them.
trim_trailing_whitespace = true
