# Copy to gopherdex.env and fill in. Every gopherdexd flag can be set here as
# GOPHERDEX_<FLAG NAME> (dashes become underscores). Keep this file private:
# it holds the SMTP password.

# The domain people type in "go get". Caddy serves it; the registry uses it
# as the module host, so modules are <domain>/<owner>/<module>.
GOPHERDEX_DOMAIN=gopherdex.example.com
GOPHERDEX_BASE_URL=https://gopherdex.example.com

# Email: sign-up verification, password resets, publish alerts.
GOPHERDEX_SMTP_ADDR=smtp.example.com:587
GOPHERDEX_SMTP_FROM=Gopherdex <no-reply@gopherdex.example.com>
GOPHERDEX_SMTP_USER=apikey
GOPHERDEX_SMTP_PASSWORD=change-me

# Usernames that review reports at /admin (they must turn on two-factor).
# Register the account first, then add it here and restart.
GOPHERDEX_ADMINS=
GOPHERDEX_REQUIRE_2FA=true

# Daily database backups inside the data volume. Also copy them off the
# machine, together with /data/blobs.
GOPHERDEX_BACKUP_DIR=/data/backups
